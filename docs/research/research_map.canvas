		},
		{
			"id": "d_s9c",
			"type": "text",
			"color": "5",
			"width": 520,
			"height": 360,
			"x": 5120,
			"y": 16924
		},
		{
			"id": "d_next9",
			"type": "text",
			"color": "3",
			"width": 520,
			"height": 230,
			"x": 5120,
			"y": 17344
		},
		{
			"id": "path-d_s9b",
			"type": "group",
			"label": "⏸ Not exploring: cross-validation (no budget)",
			"color": "1",
			"styleAttributes": {
				"border": "dashed"
			},
			"x": 5096,
			"y": 16546,
			"width": 1168,
			"height": 318
		},
		{
			"id": "path-d_s9a",
			"type": "group",
			"label": "✓ Accepted: keep the split, add 2k labels",
			"color": "4",
			"x": 5096,
			"y": 16068,
			"width": 1168,
			"height": 378
		},
		{
			"id": "lane-d_p0",
