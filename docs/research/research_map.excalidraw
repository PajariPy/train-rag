   },
   "seed": 978200696,
   "version": 19,
   "versionNonce": 1339806567,
   "isDeleted": false,
   "boundElements": [
    {
     "id": "edge-e_rp3_res_rp3_next",
     "type": "arrow"
    },
    {
     "id": "edge-e_rp3_next_rp3_wide_open",
