   "link": null,
   "locked": false,
   "text": "Test setup (\"candidates\"): for each of the 46 failed\nquestions, take vector search's own top 50 plus the\nright document (~51 candidates), and see where\nthe right one ranks among them.",
   "originalText": "Test setup (\"candidates\"): for each of the 46 failed\nquestions, take vector search's own top 50 plus the\nright document (~51 candidates), and see where\nthe right one ranks among them.",
   "fontSize": 20,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true,
   "customData": {
