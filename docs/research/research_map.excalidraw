   "isDeleted": false,
   "boundElements": [],
   "updated": 1795607209729,
   "link": null,
   "locked": false,
   "text": "• ✓ Top 30: the same quality for a third of the\n  reranker GPU time\n• Top 10: 1–4 points lower for a tenth\n• ✗ Alone: 3–8 points lower, worth it only if cost\n  matters more than those points",
   "originalText": "• ✓ Top 30: the same quality for a third of the\n  reranker GPU time\n• Top 10: 1–4 points lower for a tenth\n• ✗ Alone: 3–8 points lower, worth it only if cost\n  matters more than those points",
   "fontSize": 20,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true,
   "customData": {
    "map": "card-text",
    "card": "rp3_res"
   }
  },
  {
   "id": "card-rp3_cost",
   "type": "rectangle",
   "x": 16000.0,
   "y": 4744.0,
   "width": 520,
   "height": 326,
   "angle": 0,
   "strokeColor": "#17809a",
   "backgroundColor": "#e2f4f8",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [
    "g-rp3_cost"
   ],
   "frameId": null,
   "roundness": {
    "type": 3,
