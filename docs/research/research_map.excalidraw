  {
   "id": "text-dg_n19-1",
   "type": "text",
   "x": 8460.0,
   "y": 643.75,
   "width": 459.06,
   "height": 275.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
