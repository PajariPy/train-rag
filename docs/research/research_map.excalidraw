   "groupIds": [
    "g-rp1"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 761826877,
   "version": 22,
   "versionNonce": 1006894084,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1795607209713,
   "link": null,
   "locked": false,
   "text": "Idea: measure the real models on the local GPU\n(RTX 2000 Ada laptop, the same architecture as the\nL4), then project to SageMaker.\n• Pipeline settings: float16, real questions and\n  documents\n• Projection: an L4 or A10G is 2–3× faster than the\n  local GPU (a 4090 was ~5× faster)\n• Prices: ml.g6.xlarge (L4) ~$1.13/h, ml.g5.xlarge\n  (A10G) ~$1.41/h",
   "originalText": "Idea: measure the real models on the local GPU\n(RTX 2000 Ada laptop, the same architecture as the\nL4), then project to SageMaker.\n• Pipeline settings: float16, real questions and\n  documents\n• Projection: an L4 or A10G is 2–3× faster than the\n  local GPU (a 4090 was ~5× faster)\n• Prices: ml.g6.xlarge (L4) ~$1.13/h, ml.g5.xlarge\n  (A10G) ~$1.41/h",
   "fontSize": 20,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true,
   "customData": {
    "map": "card-text",
    "card": "rp1"
   }
  },
