# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Downloaded datasets (re-create with `uv run train-rag-download`)
data/

# Tool caches
.mypy_cache/
.ruff_cache/
.pytest_cache/

# marimo session caches
__marimo__/

# Secrets
.env

# Scratch notes, not committed
temp/

# Gemini batch inputs and raw outputs (large, regenerable)
exploration/*/data/batch_requests.jsonl
exploration/*/data/batch_results.jsonl

# Fine-tuning outputs (LoRA adapters, logs) copied back from rented GPUs
exploration/fact_extraction/runs/
exploration/embedder_finetune/runs/
exploration/embedder_finetune/vast/.instance*
exploration/training_questions/data/uuid_index.json

# Fine-tuned model weights (copied from a training run)
/models/

# Weights & Biases local run files
/wandb/
